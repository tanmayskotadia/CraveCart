# Vercel build settings. These values are public in the browser bundle.
# Leave the API origin empty when using the configured same-origin /api rewrite.
VITE_API_ORIGIN=
# Exact public HTTPS origin of your Render realtime service.
VITE_REALTIME_ORIGIN=
# Licensed raster tile URL template, including {z}/{x}/{y} and provider-required attribution.
# A provider's publishable, domain-restricted map token may be included here.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Never add MongoDB, payment, SMTP, internal signing or encryption secrets to this file.
