NODE_ENV=development
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true&replicaSet=rs0
RABBITMQ_URL=amqp://cravecart:local-only@127.0.0.1:5672/cravecart
REDIS_URL=redis://127.0.0.1:6379
INTERNAL_TOKEN=development-only-internal-token-change-me
METRICS_TOKEN=development-only-metrics-token-change-me
DEV_ADAPTERS=true
# Development defaults only. Use separate random secrets (32+ characters each) in production.
AUTH_SECRET=development-only-auth-secret-change-me
AUTH_ENCRYPTION_KEY=development-only-encryption-key-change-me
UPLOAD_ENCRYPTION_KEY=development-only-upload-key-change-me
UPLOAD_DIRECTORY=.local/uploads
UPLOAD_SCAN_MODE=development
# Production requires ClamAV and a persistent private upload volume.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# Configure actual contact delivery with DEV_ADAPTERS=false. Never put secrets in VITE_*.
# SMTP_URL=smtps://username:password@mail.your-owned-domain.example:465
# SMTP_FROM=CraveCart <signin@your-owned-domain.example>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Optional collector; omitted means no network exporter.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Hosted frontend only: set to the controlled HTTPS API origin.
# VITE_API_ORIGIN=https://api.your-owned-domain.example

# Production interactive maps require a licensed tile provider; coordinates work without tiles.
# VITE_MAP_TILE_URL=https://maps.your-owned-domain.example/{z}/{x}/{y}.png
