# Configure these in Render's secret settings. No localhost services or development adapters.
NODE_ENV=production
HOST=0.0.0.0
# Gateway only: verified ingress proxy IPs/CIDRs, comma separated. Empty trusts no forwarded IPs.
TRUSTED_PROXY_CIDRS=
MONGO_DB_PREFIX=cravecart_staging
MONGO_URI=
RABBITMQ_URL=
REDIS_URL=
APP_ORIGIN=
INTERNAL_TOKEN=
METRICS_TOKEN=
AUTH_SECRET=
# Optional provisioned administrator contact and salted scrypt hash; Auth service only. MFA remains required.
ADMIN_LOGIN_ID=
ADMIN_PASSWORD_HASH=
AUTH_ENCRYPTION_KEY=
UPLOAD_ENCRYPTION_KEY=
UPLOAD_DIRECTORY=/var/lib/cravecart/uploads
UPLOAD_SCAN_MODE=clamav
CLAMD_HOST=
CLAMD_PORT=3310
DEV_ADAPTERS=false
COMMERCE_MODE=test
PAYMENT_LIVE_CONFIRMED=false
# Cumulative per-order discretionary refunds at/above this amount require two distinct finance users.
# 0 requires two-person approval for every discretionary refund. Amounts are INR paise.
FINANCE_DUAL_APPROVAL_THRESHOLD_MINOR=0
# Set only after legal review of the published privacy notice. No retention duration is assumed.
PRIVACY_RETENTION_REVIEWED=false
PRIVACY_FINANCIAL_RETENTION_DAYS=
SMTP_URL=
SMTP_FROM=
# Optional SMS provider; email contact verification can be enabled first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=
# Stripe is optional until its sandbox is configured; unconfigured gateways are hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
# Render Blueprint supplies *_HOSTPORT for the six owner services.
# Vercel build settings: VITE_REALTIME_ORIGIN, VITE_MAP_TILE_URL, VITE_MAP_ATTRIBUTION.
# Leave VITE_API_ORIGIN unset when using the generated same-origin /api proxy.

# Optional browser push. Generate a VAPID pair privately, then set these in Render.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Assistant is useful without a model key. Configure OpenAI values only on Utils if enabled.
ASSISTANT_PROVIDER=builtin
OPENAI_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_DAILY_MESSAGES=60
ASSISTANT_DAILY_PROVIDER_CALLS=100
# Enable on Utils, Restaurant and Admin only after the documented human review.
ASSISTANT_WRITES_ENABLED=false
ASSISTANT_WRITES_REVIEWED=false
