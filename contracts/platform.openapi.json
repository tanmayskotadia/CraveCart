{
  "get": {
    "operationId": "admin_get_platform",
    "tags": [
      "admin"
    ],
    "summary": "Public India-wide discovery and launch capabilities",
    "x-owner": "admin",
    "x-contract-status": "implementation-ready",
    "x-client-generation-ready": true,
    "x-authorization": "Public read-only launch configuration. No identity, private settings or dependency URLs.",
    "security": [],
    "parameters": [],
    "description": "No query parameters or request body. Returns capabilities only, never authentication grants. Unknown query parameters return 400. Request ID is a canonical UUID; valid incoming X-Request-ID is preserved. No-store response. No idempotency key because this is a read.",
    "responses": {
      "200": {
        "description": "Current public launch capability snapshot",
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "CraveCart"
                    },
                    "market": {
                      "type": "object",
                      "properties": {
                        "country": {
                          "type": "string",
                          "const": "IN"
                        },
                        "scope": {
                          "type": "string",
                          "const": "national"
                        },
                        "currency": {
                          "type": "string",
                          "const": "INR"
                        },
                        "timezone": {
                          "type": "string",
                          "const": "Asia/Kolkata"
                        }
                      },
                      "required": [
                        "country",
                        "scope",
                        "currency",
                        "timezone"
                      ],
                      "additionalProperties": false
                    },
                    "capabilities": {
                      "type": "object",
                      "properties": {
                        "ordering": {
                          "type": "boolean"
                        },
                        "authentication": {
                          "type": "boolean"
                        },
                        "liveTracking": {
                          "type": "boolean",
                          "const": false
                        },
                        "assistant": {
                          "type": "boolean",
                          "const": false
                        }
                      },
                      "required": [
                        "ordering",
                        "authentication",
                        "liveTracking",
                        "assistant"
                      ],
                      "additionalProperties": false
                    },
                    "serviceability": {
                      "type": "string",
                      "enum": [
                        "not-configured",
                        "coordinate-check-required"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "market",
                    "capabilities",
                    "serviceability"
                  ],
                  "additionalProperties": false
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "requestId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "data",
                "meta"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "400": {
        "description": "Invalid query",
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "retryable": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "requestId",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "429": {
        "description": "Rate limited",
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "retryable": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "requestId",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "503": {
        "description": "Gateway cannot retrieve a valid correlated snapshot",
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "retryable": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "requestId",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "default": {
        "description": "Structured error",
        "content": {
          "application/json": {
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "retryable": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "requestId",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
