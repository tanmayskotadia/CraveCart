{
  "name": "cravecart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:database": "node scripts/dev-database.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "build": "tsc -b tsconfig.build.json && npm run build --workspace @cravecart/web",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p apps/web/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write apps packages services tests infra .github *.json *.mjs scripts/*.mjs",
    "format:check": "prettier --check apps packages services tests infra .github *.json *.mjs scripts/*.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:identity": "vitest run --config vitest.identity.config.ts",
    "test:e2e": "playwright test",
    "test:identity:browser": "playwright test --config playwright.identity.config.ts",
    "contracts:export": "tsx scripts/export-contracts.ts && tsx scripts/export-identity-contracts.ts",
    "contracts:build": "npm run contracts:export && python scripts/build_contracts.py",
    "contracts:check": "python scripts/validate_contracts.py",
    "check": "npm run typecheck && npm run lint && npm test && npm run contracts:check",
    "infra:up": "docker compose --env-file .env -f infra/compose/compose.yaml up --build -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose/compose.yaml down",
    "infra:logs": "docker compose --env-file .env -f infra/compose/compose.yaml logs -f"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@tanstack/react-query": "5.104.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "2.2.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongodb": "7.7.0",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "redis": "6.3.0",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/amqplib": "0.10.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "mongodb-memory-server-core": "11.3.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
